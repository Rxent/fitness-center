# Скопируйте этот файл в `.env` (для docker compose) перед запуском.
# Значения ниже — безопасные значения по умолчанию для разработки.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=fitness
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness

# Если переменная DATABASE_URL задана, Django подключится к PostgreSQL по ней.
# Если нет — проект будет использовать локальный SQLite (db.sqlite3).
# DATABASE_URL=postgres://fitness:fitness@localhost:5432/fitness
